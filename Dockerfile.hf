# Hugging Face Spaces (Docker SDK) build. Deliberately a separate file from
# the root Dockerfile used by docker-compose -- see docs/ARCHITECTURE.md's
# "Deployment: Hugging Face Spaces" section for why: this bakes BioCLIP 2's
# weights and the Qdrant index in at build time (the opposite of Milestone
# 7's call, which was specific to this dev machine's slow network -- HF's
# build servers pull weights from the HF Hub itself, so baking here is fast
# and gives every visitor an instant cold start), and runs as HF's required
# non-root uid 1000 instead of root.
FROM python:3.13-slim

WORKDIR /app

# Same hash-pinned uv.lock (CPU-only torch) as local dev and the compose
# Dockerfile -- no GPU anywhere in this project. uv is installed via pip rather
# than copied from another registry so HF's builders need nothing extra. The
# venv sits outside /app; it stays root-owned and read-only to the uid-1000
# runtime user, which is fine (bytecode is precompiled at install time).
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_HTTP_TIMEOUT=120 \
    UV_HTTP_CONNECT_TIMEOUT=60 \
    UV_HTTP_RETRIES=8 \
    PATH="/opt/venv/bin:$PATH"

RUN pip install --no-cache-dir uv==0.11.29

# uv's wheel cache is a BuildKit cache mount, so it never lands in an image
# layer (see the root Dockerfile for the 1.2 GB mistake this avoids).
COPY pyproject.toml uv.lock .python-version ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev

# Only what app.py actually needs at runtime -- no api/, no eval/, no docs.
COPY src/ src/
COPY data/species_reference.json data/species_reference.json
COPY scripts/build_index.py scripts/build_index.py
COPY app.py .

# HF Spaces containers run as uid 1000, not root (required, see
# https://huggingface.co/docs/hub/en/spaces-sdks-docker#permissions).
# Dependency installation above stays as root -- simpler than fighting
# pip's default system-site-packages permissions -- but the app directory,
# the baked index below, and the running process all end up owned by and
# running as uid 1000.
RUN useradd -m -u 1000 user && chown -R user:user /app
USER user
ENV HOME=/home/user

# Bake the species index + simulated prices in now, at build time, so a
# container start (including waking from HF's free-tier sleep) is just
# "launch Streamlit" -- no first-request delay, no dependency on the
# ephemeral filesystem surviving a restart.
RUN python scripts/build_index.py

EXPOSE 7860

CMD ["streamlit", "run", "app.py", "--server.address", "0.0.0.0", "--server.port", "7860", "--server.headless", "true"]
