# Copy to .env (git-ignored) and fill in. Never commit real values.

GEMINI_API_KEY=

# API access: one or more labeled keys, "label:secret", comma-separated. Secrets must be
# at least 24 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# With none set, every API route except /health answers 503 (fail closed).
BLOOMLENS_API_KEYS=

# Optional
# BLOOMLENS_ENV=production        # off: /docs and /openapi.json are served (docker-compose defaults the API to production)
# BLOOMLENS_MAX_UPLOAD_MB=8       # per-photo cap
# BLOOMLENS_MAX_LOT_MB=40         # whole-lot cap

# Abuse limits, shared by the API and the Streamlit app through the inventory SQLite file
# (correct for processes on ONE host; see docs/SECURITY.md). Defaults are conservative
# guesses, not your Gemini key's real limits: check those and stay below them.
# BLOOMLENS_RATE_PER_MINUTE=6          # per caller, per UTC clock minute
# BLOOMLENS_QUOTA_PER_DAY=100          # per caller, per UTC day
# BLOOMLENS_GLOBAL_QUOTA_PER_DAY=500   # everyone together, per UTC day: the budget guard
# BLOOMLENS_MAX_CONCURRENT=2           # simultaneous pipeline runs per process
