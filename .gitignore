# Environment / secrets
.env
.env.local

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Model weights / dataset caches (fetched by scripts, not committed)
data/raw/
data/oxford_flowers/
*.pt
*.pth
*.ckpt
.cache/

# Qdrant local storage
qdrant_storage/
qdrant_data/

# Inventory log (generated at runtime, not source -- same reasoning as qdrant_data/)
data/inventory.db
data/inventory.db-wal
data/inventory.db-shm

# Blinded quality-labeler submissions (tools/label_quality.py): rater ids, their experience
# notes and their labels -- personal study data, never source.
data/quality_labels.db
data/quality_labels.db-wal
data/quality_labels.db-shm

# Full Oxford 102 Flowers dump (~679MB, fetched by eval/build_test_set.py) --
# but NOT eval/test_images/, the small (~15MB) derived sample: that one IS
# committed (Milestone 7 decision, reversing an earlier Milestone 5 call) so
# CI can run the evaluation harness without a slow external dependency.
eval/raw/

# eval/open_world_data.py's similarity cache: cached deterministic model outputs, not source data
# (see that module's docstring) -- not committed, and unrelated to the committed eval/manifest/.
eval/cache/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Reference screenshots from the source tutorial (not ours to redistribute)
Screenshot *.png

# Test/coverage artifacts
.coverage
.coverage.*
htmlcov/
.pytest_cache/
